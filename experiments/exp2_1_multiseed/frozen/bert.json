  "warmup_ratio": 0.1,
  "scheduler": "linear",
  "max_grad_norm": 1.0,
  "max_length": 50,
  "fixed_threshold": 0.3,
  "threshold_candidates": [0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90],
  "rare_fraction": 0.25,
  "smoke_train_samples": 1000,
  "smoke_validation_samples": 500,
