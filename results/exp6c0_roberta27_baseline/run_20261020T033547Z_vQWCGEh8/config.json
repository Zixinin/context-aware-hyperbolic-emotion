{
  "experiment": "Exp6C-0 A0",
  "model_name": "roberta-base",
  "num_labels": 27,
  "seed": 42,
  "epochs": 4,
  "max_length": 50,
  "batch_size": 16,
  "eval_batch_size": 64,
  "gradient_accumulation_steps": 1,
  "learning_rate": 5e-05,
  "weight_decay": 0.01,
  "adam_betas": [
    0.9,
    0.999
  ],
  "adam_epsilon": 1e-08,
  "warmup_ratio": 0.1,
  "warmup_rounding": "ceil",
  "scheduler": "linear",
  "max_grad_norm": 1.0,
  "dropout": 0.1,
  "initializer_std": 0.02,
  "threshold": 0.3,
  "pooling": "last_hidden_state[:,0,:]",
  "loss": "BCEWithLogitsLoss(mean)",
  "dropout_layout": "independent_per_label_matching_Exp5A_CLS",
  "head_initialization": "discard_one_normal_draw_then_normal_0.02_matching_CLS",
  "precision": "float32",
  "attention_implementation": "eager",
  "num_workers": 0,
  "deterministic_algorithms": true,
  "rare_labels": [
    "grief",
    "pride",
    "relief",
    "nervousness",
    "embarrassment",
    "remorse",
    "fear"
  ],
  "checkpoint_rule": "highest_validation_macro_f1_at_0.30_earliest_tie",
  "filtering": "keep_any_non_neutral_positive_preserve_official_split_order",
  "neutral_diagnostic": "skipped_optional_diagnostic_to_keep_primary_test_single_pass"
}
